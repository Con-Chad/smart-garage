# Smart Garage — Docker / Unraid environment variables
# Set these in the Unraid template UI or docker-compose.
# Do not commit a real .env file.

# SQLite (single-container; file lives on the /data volume in Docker)
DATABASE_URL=file:/data/smart-garage.db

# Local development (outside Docker):
# DATABASE_URL=file:../data/smart-garage.db
# UPLOAD_DIR=../data/uploads

UPLOAD_DIR=/data/uploads
MAX_UPLOAD_SIZE_MB=25
MAX_IMAGE_SIZE_MB=10
NODE_ENV=production

# Self-registration at /register. The very first account can always be created
# (it becomes admin); after that new accounts need this flag or an admin
# (Settings -> User management). Unset = closed.
# REGISTRATION_ENABLED=true

# Limit on active mobile-app devices (API tokens) per account; the login
# answers 409 device_limit_reached once it is hit. Unset = 20.
# MAX_DEVICES_PER_USER=20

# Session cookie Secure flag: unset = works on HTTP and HTTPS (Unraid LAN default)
# SESSION_COOKIE_SECURE=true   # HTTPS-only deployments
# SESSION_COOKIE_SECURE=auto   # secure when X-Forwarded-Proto is https

# Optional single sign-on (OpenID Connect) — see docs/OIDC.md
# Leave all of these unset to keep username/password login only.
# OIDC_ISSUER=https://id.example.com
# OIDC_CLIENT_ID=smart-garage
# OIDC_CLIENT_SECRET=your-client-secret
# OIDC_BUTTON_LABEL=Pocket ID
# OIDC_REDIRECT_URI=https://garage.example.com/api/auth/oidc/callback
# OIDC_SCOPES=openid profile email
# OIDC_ALLOW_SIGNUP=false      # only allow people who already have an account
# OIDC_VERIFY_ID_TOKEN=false   # only if your provider publishes no usable JWKS

# Optional defaults for NEW accounts (existing accounts are never changed).
# Values are stored metric either way; these only pick what is displayed.
# Unset = built-in defaults.
# DEFAULT_LOCALE=en                # en | de
# DEFAULT_TIMEZONE=America/Chicago # any IANA timezone
# DEFAULT_CURRENCY=USD             # EUR | USD | GBP | CHF
# DEFAULT_DISTANCE_UNIT=mi         # km | mi
# DEFAULT_VOLUME_UNIT=gal          # l | gal (US gallon)

# Optional fuel-receipt scanner for the mobile app — see docs/mobile/RECEIPT-SCANNER.md
# Off by default. Receipt photos are sent to the Anthropic API; usage is billed
# to your Console account (separate from a Claude subscription). Never commit a key.
# RECEIPT_SCANNER_ENABLED=true
# ANTHROPIC_API_KEY=sk-ant-...
# RECEIPT_SCANNER_MODEL=claude-sonnet-5-5   # or claude-haiku-5-5 (cheaper)
# RECEIPT_SCANNER_DAILY_LIMIT=30            # scans per user per UTC day
